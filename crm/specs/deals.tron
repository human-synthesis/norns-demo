{
  "module": "deals",
  "depends": [
    "core",
    "companies",
    "contacts"
  ],
  "entities": {
    "Deal": {
      "owner": "owner",
      "fields": {
        "owner": {
          "type": "ref",
          "ref": "core.Entity.User"
        },
        "amount": {
          "type": "money"
        },
        "closeDate": {
          "type": "date",
          "optional": true
        },
        "company": {
          "type": "ref",
          "ref": "companies.Entity.Company"
        },
        "contact": {
          "type": "ref",
          "ref": "contacts.Entity.Contact",
          "optional": true
        },
        "title": {
          "type": "text"
        }
      },
      "status": {
        "lost": [],
        "open": [
          "won",
          "lost"
        ],
        "won": []
      }
    },
    "Lead": {
      "owner": "owner",
      "fields": {
        "name": {
          "type": "text"
        },
        "owner": {
          "type": "ref",
          "ref": "core.Entity.User"
        },
        "source": {
          "type": "text",
          "optional": true
        },
        "email": {
          "type": "email"
        }
      },
      "status": {
        "discarded": [],
        "new": [
          "qualified",
          "discarded"
        ],
        "qualified": []
      }
    }
  },
  "queries": {
    "inbox": {
      "from": "Lead",
      "limit": 100,
      "sort": "name"
    },
    "pipeline": {
      "from": "Deal",
      "live": true,
      "groupBy": "status"
    },
    "amounts": {
      "from": "Deal",
      "limit": 100,
      "sort": "title"
    }
  },
  "actions": {
    "lose": {
      "input": {
        "id": "Deal.id"
      },
      "requires": "status == open",
      "steps": [
        {
          "set": {
            "status": "lost",
            "entity": "Deal"
          }
        }
      ],
      "refresh": [
        "deals.Query.pipeline"
      ],
      "examples": [
        {
          "input": {
            "id": "$open"
          },
          "expect": {
            "status": "lost"
          }
        }
      ]
    },
    "qualify": {
      "input": {
        "id": "Lead.id"
      },
      "requires": "status == new",
      "steps": [
        {
          "set": {
            "status": "qualified",
            "entity": "Lead"
          }
        },
        {
          "emit": "lead.qualified"
        }
      ],
      "refresh": [
        "deals.Query.inbox"
      ],
      "examples": [
        {
          "input": {
            "id": "$new"
          },
          "expect": {
            "status": "qualified"
          }
        }
      ]
    },
    "reprice": {
      "input": {
        "amount": "Deal.amount",
        "id": "Deal.id"
      },
      "examples": [
        {
          "input": {
            "amount": 1000,
            "id": "$open"
          },
          "expect": {
            "amount": 900
          }
        }
      ],
      "impl": "custom"
    },
    "win": {
      "input": {
        "id": "Deal.id"
      },
      "requires": "status == open",
      "steps": [
        {
          "set": {
            "status": "won",
            "entity": "Deal"
          }
        },
        {
          "emit": "deal.won"
        }
      ],
      "refresh": [
        "deals.Query.pipeline"
      ],
      "examples": [
        {
          "input": {
            "id": "$open"
          },
          "expect": {
            "status": "won"
          }
        }
      ]
    }
  },
  "policies": {
    "Deal": {
      "read": "owner or role:admin",
      "write": "owner"
    },
    "Lead": {
      "read": "owner or role:admin",
      "write": "owner"
    }
  },
  "pages": {
    "leads": {
      "route": "/leads",
      "components": [
        {
          "table": "deals.Query.inbox"
        }
      ]
    },
    "pipeline": {
      "route": "/deals",
      "state": {
        "selected": "Deal.id?"
      },
      "components": [
        {
          "pipelineTotals": "deals.Query.pipeline"
        },
        {
          "kanban": "deals.Query.pipeline",
          "onMove": "deals.Action.win"
        }
      ]
    },
    "stats": {
      "route": "/stats",
      "components": [
        {
          "chart": "deals.Query.amounts",
          "type": "bar",
          "x": "title",
          "y": "amount"
        }
      ]
    }
  }
}