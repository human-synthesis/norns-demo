{
  "module": "deals",
  "depends": ["core", "companies", "contacts"],
  "entities": {
    "Deal": {
      "owner": "owner",
      "fields": {
        "owner": { "type": "ref", "ref": "core.Entity.User" },
        "amount": { "type": "money" },
        "closeDate": { "type": "date", "optional": true },
        "company": { "type": "ref", "ref": "companies.Entity.Company" },
        "contact": { "type": "ref", "ref": "contacts.Entity.Contact", "optional": true },
        "title": { "type": "text" }
      },
      "status": { "lost": [], "open": ["won", "lost"], "won": [] }
    },
    "Lead": {
      "owner": "owner",
      "fields": {
        "name": { "type": "text" },
        "owner": { "type": "ref", "ref": "core.Entity.User" },
        "source": { "type": "text", "optional": true },
        "email": { "type": "email" }
      },
      "status": { "discarded": [], "new": ["qualified", "discarded"], "qualified": [] }
    }
  },
  "queries": {
    "amounts": { "from": "Deal", "limit": 100, "sort": "title" },
    "inbox": { "from": "Lead", "limit": 100, "sort": "name" },
    "pipeline": { "from": "Deal", "live": true, "groupBy": "status" }
  },
  "actions": {
    "lose": {
      "input": { "id": "Deal.id" },
      "requires": "status == open",
      "steps": [{ "set": { "status": "lost", "entity": "Deal" } }],
      "refresh": ["deals.Query.pipeline"],
      "examples": [{ "input": { "id": "$open" }, "expect": { "status": "lost" } }]
    },
    "qualify": {
      "input": { "id": "Lead.id" },
      "requires": "status == new",
      "steps": [{ "set": { "status": "qualified", "entity": "Lead" } }, { "emit": "lead.qualified" }],
      "refresh": ["deals.Query.inbox"],
      "examples": [{ "input": { "id": "$new" }, "expect": { "status": "qualified" } }]
    },
    "reprice": {
      "input": { "amount": "Deal.amount", "id": "Deal.id" },
      "examples": [{ "input": { "amount": 1000, "id": "$open" }, "expect": { "amount": 900 } }],
      "impl": "custom"
    },
    "win": {
      "input": { "id": "Deal.id" },
      "requires": "status == open",
      "steps": [
        { "set": { "status": "won", "entity": "Deal" } },
        { "emit": "deal.won" },
        { "enqueue": "sendWinEmail", "with": { "id": "input.id" } }
      ],
      "refresh": ["deals.Query.pipeline"],
      "examples": [{ "input": { "id": "$open" }, "expect": { "status": "won" } }]
    }
  },
  "policies": {
    "Deal": { "read": "owner or role:admin", "write": "owner" },
    "Lead": { "read": "owner or role:admin", "write": "owner" }
  },
  "pages": {
    "leads": {
      "route": "/leads",
      "components": [{ "cell": "deals.Snippet.statusCell", "table": "deals.Query.inbox" }]
    },
    "pipeline": {
      "route": "/deals",
      "state": { "selected": "Deal.id?" },
      "components": [
        { "pipelineTotals": "deals.Query.pipeline" },
        { "kanban": "deals.Query.pipeline", "onMove": "deals.Action.win" }
      ]
    },
    "stats": {
      "route": "/stats",
      "components": [{ "type": "bar", "chart": "deals.Query.amounts", "x": "title", "y": "amount" }]
    }
  },
  "endpoints": {
    "stripeWebhook": {
      "route": "/api/stripe/webhook",
      "input": { "type": "text", "data": "json" },
      "examples": [
        {
          "input": { "type": "invoice.paid", "data": { "dealId": "deal-1" } },
          "expect": { "received": true }
        }
      ],
      "impl": "custom",
      "auth": { "binding": "STRIPE_WEBHOOK_SECRET", "mode": "hmac" },
      "method": "POST",
      "output": { "received": "bool" }
    }
  },
  "jobs": {
    "sendWinEmail": {
      "input": { "id": "text" },
      "examples": [{ "input": { "id": "deal-1" }, "expect": { "sent": true } }],
      "impl": "custom",
      "dlq": "win-email-dlq",
      "retry": { "attempts": 3, "backoff": "exponential", "baseMs": 1000 }
    }
  },
  "services": {
    "mailer": {
      "auth": { "binding": "MAILER_TOKEN", "mode": "bearer" },
      "base": "https://api.resend.com",
      "operations": {
        "send": {
          "input": { "html": "text", "subject": "text", "to": "text" },
          "method": "POST",
          "output": { "id": "text" },
          "path": "/emails"
        }
      }
    }
  },
  "snippets": {
    "statusCell": { "args": ["row", "column", "value"], "description": "status pill in deal tables" }
  }
}
