ToastProvider

//- ============================================================
//- HERO
//- ============================================================
section.relative.overflow-hidden
	//- Soft background spotlight, behind everything.
	.absolute.inset-0.pointer-events-none(
		style="background: radial-gradient(60% 50% at 50% 0%, color-mix(in oklab, var(--color-primary-500) 18%, transparent), transparent 70%);"
	)
	div(class="relative max-w-5xl mx-auto px-6 py-24 md:py-32 text-center")
		.flex.justify-center.mb-6
			Chip(icon="lucide:sparkles" class="bg-primary-50 text-primary-700 border-primary-200")
				| New · norns-ui v0.0.7 is out
		h1.font-bold.tracking-tight.mb-6(class="text-5xl md:text-7xl leading-[1.05]")
			| Ship full-stack apps
			br
			GradientText(animate!="{true}" from="var(--color-primary-500)" via="var(--color-info-500)" to="var(--color-success-500)")
				| in minutes, not weeks
		p.text-lg.leading-relaxed.max-w-2xl.mx-auto.mb-8(class="md:text-xl text-fg-muted")
			| Norns is the batteries-included meta-framework for Svelte. Pug + Civet,
			| feature folders, valibot routes, migrations, DI — all wired up the day you clone.
		.flex.flex-wrap.items-center.justify-center.gap-3
			Sparkles
				Btn(variant="primary" size="lg" icon="lucide:rocket" href="/examples") Start building
			Btn(variant="ghost" size="lg" icon="lucide:github" href="https://github.com/human-synthesis/norns" target="_blank" rel="noopener") View on GitHub
		.flex.flex-wrap.items-center.justify-center.gap-x-6.gap-y-3.pt-10.text-sm(class="text-fg-muted")
			.flex.items-center.gap-2
				Icon(name="lucide:check-circle-2" size="size-4" class="text-success-500")
				| No config required
			.flex.items-center.gap-2
				Icon(name="lucide:check-circle-2" size="size-4" class="text-success-500")
				| TypeScript-aware
			.flex.items-center.gap-2
				Icon(name="lucide:check-circle-2" size="size-4" class="text-success-500")
				| MIT licensed
			.flex.items-center.gap-2
				Icon(name="lucide:check-circle-2" size="size-4" class="text-success-500")
				| Self-host or deploy

//- ============================================================
//- TRUST STRIP
//- ============================================================
section.border-y.border-border(class="bg-bg-subtle/40")
	.max-w-5xl.mx-auto.px-6.py-8
		p.text-center.text-xs.uppercase.tracking-wider.mb-5(class="text-fg-subtle")
			| Built on the tools you already love
		.flex.flex-wrap.items-center.justify-center.gap-x-12.gap-y-4(class="text-fg-muted")
			.flex.items-center.gap-2.text-lg.font-semibold
				Icon(name="lucide:zap" size="size-5" class="text-warning-500")
				| Svelte 5
			.flex.items-center.gap-2.text-lg.font-semibold
				Icon(name="lucide:wind" size="size-5" class="text-info-500")
				| Tailwind v4
			.flex.items-center.gap-2.text-lg.font-semibold
				Icon(name="lucide:terminal" size="size-5")
				| Civet
			.flex.items-center.gap-2.text-lg.font-semibold
				Icon(name="lucide:braces" size="size-5" class="text-success-500")
				| valibot
			.flex.items-center.gap-2.text-lg.font-semibold
				Icon(name="lucide:database" size="size-5" class="text-primary-500")
				| SQLite + D1

