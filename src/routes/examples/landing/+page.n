//- NEWSLETTER / CTA
//- ============================================================
section
	.max-w-5xl.mx-auto.px-6.py-20
		Card(class="text-center" padded!="{false}")
			div(class="p-10 md:p-16 relative overflow-hidden")
				.absolute.inset-0.opacity-50(
					style="background: radial-gradient(50% 60% at 50% 100%, color-mix(in oklab, var(--color-primary-500) 22%, transparent), transparent 70%);"
				)
				.relative
					h2.text-3xl.font-bold.tracking-tight.mb-3(class="md:text-4xl") Stay in the loop
					p.text-base.max-w-xl.mx-auto.mb-6(class="text-fg-muted")
						| One short email a month with release notes, recipes, and the occasional postmortem.
					form(onsubmit!="{onSubscribe}" class="max-w-md mx-auto")
						.flex.flex-col.gap-3(class="sm:flex-row")
							Field(name="email" class="flex-1")
								Input(name="email" type="email" placeholder="you@your-domain.com" required bind:value!="{email}")
							Btn(variant="primary" type="submit" icon="lucide:send") Subscribe
					p.text-xs.mt-3(class="text-fg-subtle") We never share your email. Unsubscribe in one click.

