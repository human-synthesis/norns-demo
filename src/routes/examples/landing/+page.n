section
	.max-w-5xl.mx-auto.px-6.py-16
		.grid.gap-6(class="md:grid-cols-4")
			.text-center
				.text-4xl.font-bold.tracking-tight(class="md:text-5xl")
					AnimatedNumber(value!="{12480}" duration!="{1.6}")
				.text-sm.mt-1(class="text-fg-muted") Apps shipped
			.text-center
				.text-4xl.font-bold.tracking-tight(class="md:text-5xl")
					AnimatedNumber(value!="{72}" duration!="{1.2}")
					span.text-2xl.align-text-top(class="text-fg-muted") +
				.text-sm.mt-1(class="text-fg-muted") Components
			.text-center
				.text-4xl.font-bold.tracking-tight(class="md:text-5xl")
					AnimatedNumber(value!="{56}" duration!="{1.4}")
					span(class="text-fg-muted") kB
				.text-sm.mt-1(class="text-fg-muted") Package size (gzip)
			.text-center
				.text-4xl.font-bold.tracking-tight(class="md:text-5xl")
					| &lt;
					AnimatedNumber(value!="{5}" duration!="{1.0}")
					span(class="text-fg-muted") m
				.text-sm.mt-1(class="text-fg-muted") Time to first deploy

//- ============================================================
