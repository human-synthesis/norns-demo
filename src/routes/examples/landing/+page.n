section.border-t.border-border.mt-10
	.max-w-6xl.mx-auto.px-6.py-12
		.grid.gap-8(class="md:grid-cols-4")
			div(class="md:col-span-2")
				.flex.items-center.gap-2.mb-3
					.size-7.rounded.flex.items-center.justify-center.text-white.font-bold.text-sm(style="background: var(--color-primary-600)") N
					span.text-lg.font-bold.tracking-tight Norns
				p.text-sm.max-w-sm(class="text-fg-muted") The batteries-included meta-framework for Svelte. Open source, MIT licensed.
				.flex.items-center.gap-2.mt-4
					a.btn-icon(href="https://github.com/human-synthesis/norns" target="_blank" rel="noopener" aria-label="GitHub")
						Icon(name="lucide:github" size="size-4")
					a.btn-icon(href="#" aria-label="X")
						Icon(name="lucide:twitter" size="size-4")
					a.btn-icon(href="#" aria-label="YouTube")
						Icon(name="lucide:youtube" size="size-4")
					a.btn-icon(href="#" aria-label="Discord")
						Icon(name="lucide:message-circle" size="size-4")
			div
				h3.text-sm.font-semibold.mb-3 Product
				ul.list-none.p-0.space-y-2.text-sm
					li
						a.nav-link.px-0.py-0(href="/examples/ui") Components
					li
						a.nav-link.px-0.py-0(href="/examples") Examples
					li
						a.nav-link.px-0.py-0(href="#") Roadmap
					li
						a.nav-link.px-0.py-0(href="#") Changelog
			div
				h3.text-sm.font-semibold.mb-3 Resources
				ul.list-none.p-0.space-y-2.text-sm
					li
						a.nav-link.px-0.py-0(href="#") Docs
					li
						a.nav-link.px-0.py-0(href="#") Guides
					li
						a.nav-link.px-0.py-0(href="#") API reference
					li
						a.nav-link.px-0.py-0(href="https://github.com/human-synthesis/norns" target="_blank" rel="noopener") GitHub
		.flex.items-center.justify-between.mt-10.pt-6.border-t.border-border.text-xs(class="text-fg-subtle")
			div © {new Date().getFullYear()} Human Synthesis · Made with norns-ui
			div Built with Svelte 5 + Tailwind v4

<script>
	import { toast } from '@human-synthesis/norns-ui/toast'
	import { addCollection } from '@iconify/svelte'
	import lucideIcons from '@iconify-json/lucide/icons.json'

	// Motion-driven components live in the opt-in /motion subpath so they
	// don't get auto-bundled into pages that don't need them.
	import AnimatedNumber from '@human-synthesis/norns-ui/motion/AnimatedNumber.n'
	import Sparkles from '@human-synthesis/norns-ui/motion/Sparkles.n'

	addCollection lucideIcons

	email .= $state ''

	onSubscribe := (e) =>
		e.preventDefault()
		return unless email
		toast `Thanks! We'll send the next issue to ${email}.`, { variant: 'success' }
		email = ''

	// Build the Accordion items list in JS rather than as an inline literal
	// in a Pug attribute — keeps the template tidy and the quoting sane.
	faqItems := (f1, f2, f3, f4, f5) => [
		{ value: 'a', title: 'Can I use it with existing SvelteKit apps?', content: f1 }
		{ value: 'b', title: 'Why Civet on top of Svelte?', content: f2 }
		{ value: 'c', title: "What's the license?", content: f3 }
		{ value: 'd', title: 'Can I use norns-ui without Civet?', content: f4 }
		{ value: 'e', title: 'Is it production-ready?', content: f5 }
	]

	stepperSteps := [
		{ label: 'Clone the starter',  description: 'One npm create, two questions. Done in 30 seconds.' }
		{ label: 'Compose features',   description: 'Drop feature folders under src/lib/norns/<name>/. Norns wires them up.' }
		{ label: 'Ship a route',       description: '+page.n + +page.server.c. Validated by valibot at the boundary.' }
		{ label: 'Deploy',             description: 'Cloudflare, Node, Vercel — pick your adapter. Migrations run first.' }
	]

	testimonials := [
		{ name: 'Ada Lovelace',    role: 'Founding engineer, Loomstack',  quote: 'I went from blank repo to a deployed app with auth + a DB in one evening. Norns just gets out of the way.' }
		{ name: 'Grace Hopper',    role: 'Staff engineer, Cobol Cloud',   quote: 'Pug + Civet sounded like a meme until I tried it. Now every spare line in our codebase feels noisy.' }
		{ name: 'Donald Knuth',    role: 'Maintainer, TeXLetters',        quote: 'The type-shim drift detector caught three bugs in our first migration. The migration ran in 12ms.' }
		{ name: 'Linus Torvalds',  role: 'Engineer, Pengwin Labs',         quote: 'Tailwind + role tokens means I stopped writing CSS. The design team is suspicious — in a good way.' }
		{ name: 'Anders Hejlsberg',role: 'PL person, Strongly Typed Ltd', quote: "It's Svelte but it feels like one person built the whole stack on purpose. Coherent." }
		{ name: 'Margaret Hamilton', role: 'CTO, Trajectory.io',           quote: 'Production-ready feature folders, DI, valibot. We deleted half our app code.' }
	]
</script>
