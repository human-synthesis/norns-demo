section(class="bg-bg-subtle/40")
	.max-w-6xl.mx-auto.px-6.py-20
		.text-center.max-w-2xl.mx-auto.mb-12
			Badge(variant="primary" class="mb-3") Features
			h2.text-3xl.font-bold.tracking-tight.mb-3(class="md:text-4xl") Everything you need, nothing you don't
			p.text-base(class="text-fg-muted")
				| Pick the pieces that fit. Each one is composable, typed, and small enough to read in one sitting.
		.grid.gap-4(class="md:grid-cols-3")
			Card(interactive!="{true}")
				.size-10.rounded-lg.flex.items-center.justify-center.mb-4(style="background: var(--color-primary-100); color: var(--color-primary-700)")
					Icon(name="lucide:zap" size="size-5")
				h3.text-base.font-semibold.mb-2 Pug + Civet
				p.text-sm(class="text-fg-muted")
					| Concise template syntax, type-aware script. Write
					code count .= $state 0
					| ; reactivity just works.
			Card(interactive!="{true}")
				.size-10.rounded-lg.flex.items-center.justify-center.mb-4(style="background: var(--color-info-100); color: var(--color-info-700)")
					Icon(name="lucide:layers" size="size-5")
				h3.text-base.font-semibold.mb-2 Feature folders
				p.text-sm(class="text-fg-muted")
					| Co-locate schema, service, repo. Sharing names across server / shared / client without re-imports.
			Card(interactive!="{true}")
				.size-10.rounded-lg.flex.items-center.justify-center.mb-4(style="background: var(--color-success-100); color: var(--color-success-700)")
					Icon(name="lucide:shield-check" size="size-5")
				h3.text-base.font-semibold.mb-2 Typed routes
				p.text-sm(class="text-fg-muted")
					| valibot schemas validate
					code form!
					|  + load data at the boundary. End-to-end TS.
			Card(interactive!="{true}")
				.size-10.rounded-lg.flex.items-center.justify-center.mb-4(style="background: var(--color-warning-100); color: var(--color-warning-700)")
					Icon(name="lucide:database" size="size-5")
				h3.text-base.font-semibold.mb-2 Migrations baked in
				p.text-sm(class="text-fg-muted")
					code norns migrate
					|  for SQLite + D1. Forward-only, idempotent, with a stamped schema table.
			Card(interactive!="{true}")
				.size-10.rounded-lg.flex.items-center.justify-center.mb-4(style="background: var(--color-danger-100); color: var(--color-danger-700)")
					Icon(name="lucide:component" size="size-5")
				h3.text-base.font-semibold.mb-2 norns-ui
				p.text-sm(class="text-fg-muted")
					| 70+ components on role tokens. Auto-imported. Drop a
					code .n
					| file in your project to override.
			Card(interactive!="{true}")
				.size-10.rounded-lg.flex.items-center.justify-center.mb-4(style="background: var(--color-bg-muted); color: var(--color-fg)")
					Icon(name="lucide:moon" size="size-5")
				h3.text-base.font-semibold.mb-2 Dark mode for free
				p.text-sm(class="text-fg-muted")
					| Role-token theme swap on
					code [data-theme="dark"]
					| . No per-component
					code class:dark
					|  noise.

//- ============================================================
//- HOW IT WORKS
//- ============================================================
section
	.max-w-5xl.mx-auto.px-6.py-20
		.text-center.max-w-2xl.mx-auto.mb-10
			Badge(variant="info" class="mb-3") How it works
			h2.text-3xl.font-bold.tracking-tight.mb-3(class="md:text-4xl") From clone to deploy
			p.text-base(class="text-fg-muted") Four steps. Most of them are one command each.
		.hidden(class="md:block")
			Stepper(steps!="{stepperSteps}" current!="{3}")
		.grid.gap-4.mt-6(class="md:grid-cols-2 lg:grid-cols-4")
			+each('stepperSteps as step, i')
				Card
					.flex.items-start.gap-3.mb-3
						.size-8.rounded-full.flex.items-center.justify-center.text-sm.font-bold(style="background: var(--color-primary-600); color: white")
							| {i + 1}
						h3.text-base.font-semibold.pt-1 {step.label}
					p.text-sm(class="text-fg-muted") {step.description}

