section.animate-in.space-y-3
	a.text-sm.nav-link.inline-flex.items-center.gap-1(href="/examples/norns") ← Norns examples
	h1.text-4xl.font-bold.tracking-tight.leading-none
		GradientText Notes
	p.max-w-prose.leading-relaxed(class="text-fg-muted")
		| SQLite-backed CRUD with SvelteKit form
		code actions
		| and SSR
		code load
		| — no client-side fetch.

section.animate-in-delayed.pt-8.space-y-6
	Form(action="?/create" form!="{form}")
		Field(label="Title" name="title" required)
			Input(name="title" placeholder="title…" value!="{form?.values?.title ?? ''}" required)
		Field(label="Body" name="body" help="Optional")
			Textarea(name="body" placeholder="body (optional)…" rows="3" value!="{form?.values?.body ?? ''}")
		Btn(type="submit" variant="primary") Create note

	+if('data.notes.length === 0')
		Banner(variant="info" icon="lucide:info") No notes yet — create one above
	+else
		.space-y-2
			+each('data.notes as note (note.id)')
				Card(href!="/examples/norns/notes/{note.id}")
					.font-semibold.leading-tight {note.title}
					+if('note.body')
						.text-sm.mt-1.line-clamp-2(class="text-fg-muted") {note.body}
					.text-xs.mt-2(class="text-fg-subtle") updated {new Date(note.updated_at).toLocaleString()}

<script>
	{ data, form } := $props()
