.tt-game.space-y-6
	.tt-toolbar
		.tt-stats
			.tt-stat
				.tt-stat-label X
				.tt-stat-value {$stats.X}
			.tt-stat-divider
			.tt-stat
				.tt-stat-label O
				.tt-stat-value {$stats.O}
			.tt-stat-divider
			.tt-stat
				.tt-stat-label Draws
				.tt-stat-value {$stats.draw}
		ToggleButtonGroup(items!="{modeItems}" value!="{$mode}" onchange!="{(v) => v && switchMode(v)}")

	Board(
		cells!="{$board}"
		winningLine!="{$result?.line ?? []}"
		disabled!="{($mode === 'vs-pc' && $turn === 'O') || !!$result}"
		onCellClick!="{handleClick}"
	)

	.tt-bottom
		+if('$result?.winner')
			.tt-status.tt-status-win Player {$result.winner} wins!
		+elseif('$result')
			.tt-status.tt-status-draw It's a draw
		+else
			.tt-status Player {$turn}'s turn
		Btn(variant="secondary" size="sm" icon="lucide:rotate-ccw" onclick!="{handleReset}") Reset

<script>
	import { mode, board, turn, stats, result, play, reset, setMode, incrementStats } from './store'
	import { scheduleAiMove } from './ai'

	notified .= $state false

	$effect =>
		if $result?
			unless notified
				incrementStats $result.winner
				notified = true
		else
			notified = false

	handleClick := (idx) =>
		play idx
		scheduleAiMove()

	handleReset := =>
		reset()

	switchMode := (m) =>
		setMode m

	modeItems := [
		{ value: '1v1', label: '1v1' }
		{ value: 'vs-pc', label: 'vs PC' }
	]
