ToastProvider

section.animate-in.flex.items-start.justify-between.gap-4
	div.space-y-2
		a.nav-link.text-sm.inline-flex.items-center.gap-1(href="/examples") ← examples
		h1.text-5xl.font-bold.tracking-tight.leading-none
			span.gradient-text norns-ui
		p.text-base.max-w-prose.leading-relaxed.text-fg-muted
			| Every component in
			code @human-synthesis/norns-ui
			| with its variants. Toggle the theme to verify dark-mode contrast.
	ThemeToggler(showLabel!="{true}")

//- ============================================================
//- TYPOGRAPHY
//- ============================================================
section.pt-12.space-y-3
	h2 Typography
	p.text-sm.text-fg-muted Bare HTML elements pick up the library defaults. No wrapper components needed.
	Card
		.space-y-4
			h1 Heading 1
			h2 Heading 2
			h3 Heading 3
			h4 Heading 4
			h5 Heading 5
			h6 Heading 6
			p Body paragraph. The lazy dog jumps over the quick brown fox, then thinks better of it and curls up by the fire. Default
				code line-height
				| , default
				code font-family
				| , default contrast role tokens.
			p.text-fg-muted Muted paragraph using
				code .text-fg-muted
				| utility — for secondary copy.
			p
				| Inline
				code code
				| , a pre block, and a
				kbd ⌘ K
				| keyboard hint.
			pre
				| {codeSample}
			hr
			blockquote.pl-4.italic.border-l-4.border-border.text-fg-muted
				| “Programs must be written for people to read, and only incidentally for machines to execute.”

//- ============================================================
//- COLORS
//- ============================================================
section.pt-12.space-y-3
	h2 Colors
	p.text-sm.text-fg-muted
		| Five oklch scales (50–950) for
		code primary
		| ,
		code success
		| ,
		code warning
		| ,
		code danger
		| ,
		code info
		| . Use as
		code bg-&lt;name&gt;-&lt;step&gt;
		| ,
		code text-&lt;name&gt;-&lt;step&gt;
		| ,
		code border-&lt;name&gt;-&lt;step&gt;
		| .
	Card
		div.space-y-6
			+each('paletteRows as row')
				div.space-y-2
					div.flex.items-baseline.justify-between
						div.text-sm.font-mono.font-semibold.text-fg {row.name}
						div.text-xs.font-mono.text-fg-subtle 50 — 950
					div.grid.items-stretch.grid-cols-11.gap-1.5
						+each('palette as step')
							div(
								class="h-28 rounded-md flex flex-col items-center justify-between font-mono transition-transform cursor-pointer text-[10px] py-1.5 hover:scale-105"
								style!="{`background: var(--color-${row.name}-${step}); color: ${step >= 500 ? 'white' : 'oklch(20% 0 0)'}`}"
								title!="{`var(--color-${row.name}-${step})`}"
							)
								| {step}
								span.opacity-70 {row.name.slice(0, 1).toUpperCase()}

//- ============================================================
//- ROLE TOKENS (contrast probe)
//- ============================================================
section.pt-12.space-y-3
	h2 Role tokens
	p.text-sm.text-fg-muted What atoms reference. Swap themes — these are the cells that change.
	.grid.gap-3.sm:grid-cols-3
		div.p-3.rounded.bg-bg.text-fg.border.border-border fg on bg
		div.p-3.rounded.bg-bg-muted.text-fg fg on bg-muted
		div.p-3.rounded.bg-bg-elevated.text-fg.border.border-border fg on bg-elevated
		div.p-3.rounded.bg-bg.text-fg-muted.border.border-border fg-muted on bg
		div.p-3.rounded.bg-bg.text-fg-subtle.border.border-border fg-subtle on bg
		div.p-3.rounded.bg-primary-600.text-white white on primary-600
		div.p-3.rounded.bg-success-bg.text-success-fg.border.border-success-border success
		div.p-3.rounded.bg-warning-bg.text-warning-fg.border.border-warning-border warning
		div.p-3.rounded.bg-danger-bg.text-danger-fg.border.border-danger-border danger

//- ============================================================
//- ICON
//- ============================================================
section.pt-12.space-y-3
	h2 Icon
	p.text-sm.text-fg-muted Iconify wrapper. Default collection is
		code lucide
		| ; install + register more via
		code addCollection
		| .
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Common glyphs
			.flex.flex-wrap.items-center.gap-4.text-fg
				Icon(name="lucide:home" size="size-5")
				Icon(name="lucide:search" size="size-5")
				Icon(name="lucide:settings" size="size-5")
				Icon(name="lucide:bell" size="size-5")
				Icon(name="lucide:heart" size="size-5")
				Icon(name="lucide:star" size="size-5")
				Icon(name="lucide:check-circle-2" size="size-5")
				Icon(name="lucide:plus" size="size-5")
				Icon(name="lucide:trash-2" size="size-5")
				Icon(name="lucide:download" size="size-5")
				Icon(name="lucide:upload" size="size-5")
				Icon(name="lucide:link" size="size-5")
		Card
			+snippet('header')
				h3.text-base.font-semibold Sizes / tinted
			.flex.flex-wrap.items-center.gap-4
				Icon.text-fg-muted(name="lucide:zap" size="size-4")
				Icon.text-warning-500(name="lucide:zap" size="size-5")
				Icon.text-warning-600(name="lucide:zap" size="size-6")
				Icon.text-warning-700(name="lucide:zap" size="size-7")
			.flex.flex-wrap.items-center.gap-4.mt-3
				Icon.text-success-500(name="lucide:check-circle-2" size="size-5")
				Icon.text-warning-500(name="lucide:alert-triangle" size="size-5")
				Icon.text-danger-500(name="lucide:x-circle" size="size-5")
				Icon.text-info-500(name="lucide:info" size="size-5")
				Icon.text-primary-500(name="lucide:sparkles" size="size-6")
				Icon.text-primary-600(name="lucide:rocket" size="size-7")

//- ============================================================
//- BUTTONS
//- ============================================================
section.pt-12.space-y-3
	h2 Btn
	p.text-sm.text-fg-muted Variants, sizes, loading state, icon prop, snippet slots. Polymorphic — pass
		code href
		| to render an
		code &lt;a&gt;
		| instead.
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Variants
			.flex.flex-wrap.items-center.gap-3
				Btn(variant="primary") primary
				Btn(variant="secondary") secondary
				Btn(variant="ghost") ghost
				Btn(variant="danger") danger
				Btn(variant="link") link
		Card
			+snippet('header')
				h3.text-base.font-semibold Sizes
			.flex.flex-wrap.items-center.gap-3
				Btn(size="sm") small
				Btn(size="md") medium
				Btn(size="lg") large
			.flex.flex-wrap.items-center.gap-3.mt-3
				Btn(variant="primary" size="sm" icon="lucide:plus") add
				Btn(variant="secondary" icon="lucide:download") download
				Btn(variant="danger" size="lg" icon="lucide:trash-2") delete
		Card
			+snippet('header')
				h3.text-base.font-semibold States
			.flex.flex-wrap.items-center.gap-3
				Btn(disabled) disabled
				Btn(loading!="{true}") loading
				Btn(variant="secondary" loading!="{true}" size="sm") saving…
				Btn(variant="danger" loading!="{true}" size="lg") deleting…
		Card
			+snippet('header')
				h3.text-base.font-semibold Icon-only / icon slots
			.flex.flex-wrap.items-center.gap-3
				Btn(variant="ghost" icon="lucide:settings" aria-label="Settings")
				Btn(variant="secondary" icon="lucide:bell" aria-label="Notifications")
				Btn(variant="primary" size="sm" icon="lucide:check" aria-label="Confirm")
				Btn(variant="primary")
					| save
					+snippet('trailing')
						Icon(name="lucide:arrow-right" size="size-4")
				Btn(variant="secondary")
					+snippet('leading')
						Icon(name="lucide:filter" size="size-4")
					| filters
		Card.md:col-span-2
			+snippet('header')
				h3.text-base.font-semibold Full-width / link buttons
			.space-y-3
				Btn.w-full(variant="primary" icon="lucide:rocket") full-width primary
				Btn.w-full(variant="secondary" icon="lucide:github" href="https://github.com/human-synthesis/norns" target="_blank" rel="noopener") rendered as &lt;a&gt; via href

//- ============================================================
//- INPUTS
//- ============================================================
section.pt-12.space-y-3
	h2 Input / Textarea / Select
	p.text-sm.text-fg-muted Form controls. Field wraps with label, help, error.
	Card
		.grid.gap-6.sm:grid-cols-2
			Field(label="Default")
				Input(name="a" placeholder="type here…")
			Field(label="With error" error="this field is required")
				Input(name="b" placeholder="oh no")
			Field(label="Small" help="size='sm'")
				Input(name="c" size="sm" placeholder="small input")
			Field(label="Disabled")
				Input(name="d" disabled value="can't touch this")
			Field(label="Email" help="autocomplete + type")
				Input(name="e" type="email" autocomplete="email" placeholder="you@host.com")
			Field(label="Select" help="children: option elements")
				Select(name="f")
					option(value="a") option a
					option(value="b") option b
					option(value="c") option c
		.mt-6
			Field(label="Textarea" help="rows=3")
				Textarea(name="g" rows="3" placeholder="multi-line…")

//- ============================================================
//- TOGGLES
//- ============================================================
section.pt-12.space-y-3
	h2 Checkbox / Radio / Switch
	p.text-sm.text-fg-muted Native form controls; accent color comes from
		code --color-primary-600
		| .
	Card
		.grid.gap-6.sm:grid-cols-3
			Field(label="Checkbox")
				label.field-row
					Checkbox(name="agree")
					span.text-sm I agree
			Field(label="Radio")
				.space-y-1
					label.field-row
						Radio(name="size" value="s" bind:group!="{radio}")
						span.text-sm Small
					label.field-row
						Radio(name="size" value="m" bind:group!="{radio}")
						span.text-sm Medium
					label.field-row
						Radio(name="size" value="l" bind:group!="{radio}")
						span.text-sm Large
			Field(label="Switch")
				label.field-row
					Switch(name="notify" bind:checked!="{toggle}")
					span.text-sm Notifications

//- ============================================================
//- DISPLAY: CARD / SURFACE
//- ============================================================
section.pt-12.space-y-3
	h2 Card / Surface
	p.text-sm.text-fg-muted Surface primitives. Card has structural header / body / footer slots; Surface is a bare panel. Card is polymorphic — pass
		code href
		| to render as an
		code &lt;a&gt;
		| .
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Header + footer
			p.text-sm Body content goes here. Padded by default.
			+snippet('footer')
				.flex.justify-end.gap-2
					Btn(variant="ghost" size="sm") Cancel
					Btn(variant="primary" size="sm") Confirm
		Card(interactive!="{true}")
			h3.text-base.font-semibold.mb-2 Interactive
			p.text-sm Hover me. The border shifts + lift on hover.
		Card(href="/examples" interactive!="{true}")
			.flex.items-start.justify-between.gap-3.mb-2
				h3.text-base.font-semibold Link card
				Icon.text-fg-muted(name="lucide:arrow-up-right" size="size-4")
			p.text-sm.text-fg-muted Rendered as
				code &lt;a&gt;
				| via
				code href
				| — click anywhere on the card.
		Card(padded!="{false}")
			.p-3.rounded-t-lg(style="background: var(--color-primary-100)")
				.text-xs.font-mono.text-primary-900 padded={'{'}false{'}'}
			.p-5
				p.text-sm.m-0 Unpadded card lets you bleed custom regions to the edge.
		Surface
			h3.text-base.font-semibold.mb-1 Surface
			p.text-sm.opacity-80 Bare elevated panel — same role tokens, no structural slots.
		Surface.backdrop-blur-md(tone="glass")
			h3.text-base.font-semibold.mb-1 Surface glass
			p.text-sm.opacity-80 Same atom with
				code tone="glass"
				| — semi-transparent + backdrop blur.

//- ============================================================
//- BANNERS
//- ============================================================
section.pt-12.space-y-3
	h2 Banner
	p.text-sm.text-fg-muted Variants, optional icon, optional actions. Inline tinted surface for non-blocking messages.
	.grid.gap-3.md:grid-cols-2
		Banner(variant="info" icon="lucide:info")
			| Heads up — this is informational.
		Banner(variant="success" icon="lucide:check-circle-2")
			| Saved successfully.
		Banner(variant="warning" icon="lucide:alert-triangle")
			| Take a closer look at this.
			+snippet('actions')
				Btn(variant="ghost" size="sm") Dismiss
		Banner(variant="danger" icon="lucide:x-circle")
			| Something went wrong.
			+snippet('actions')
				Btn(variant="danger" size="sm") Retry
		Banner(variant="info")
			| No icon, single line. Use when context already conveys severity.
		Banner(variant="success" icon="lucide:check-circle-2")
			.space-y-1
				.font-medium All clear
				p.text-xs.text-fg-muted Multi-line banner with a heading + description.

//- ============================================================
//- BADGES + CHIPS
//- ============================================================
section.pt-12.space-y-3
	h2 Badge / Chip
	p.text-sm.text-fg-muted Compact status indicators. Badge is read-only; Chip is interactive (filter, removable).
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Badge
			.space-y-3
				.flex.flex-wrap.items-center.gap-2
					Badge default
					Badge(variant="primary") primary
					Badge(variant="success") success
					Badge(variant="warning") warning
					Badge(variant="danger") danger
					Badge(variant="info") info
				.flex.flex-wrap.items-center.gap-2
					Badge(size="sm" variant="success") small
					Badge(size="sm" variant="warning") small
					Badge(variant="primary")
						Icon(name="lucide:zap" size="size-3")
						| with icon
					Badge(variant="success")
						span.size-1.5.rounded-full(style="background: currentColor")
						| online
		Card
			+snippet('header')
				h3.text-base.font-semibold Chip
			.space-y-3
				.flex.flex-wrap.items-center.gap-2
					Chip(icon="lucide:tag") tag
					Chip(removable!="{true}" onremove!="{() => toast('Removed')}") removable
					Chip(icon="lucide:user" removable!="{true}" onremove!="{() => toast('Removed')}") with icon
				.flex.flex-wrap.items-center.gap-2
					Chip(icon="lucide:filter") filter
					Chip(icon="lucide:globe") public
					Chip.bg-success-bg.text-success-fg.border-success-border(icon="lucide:check") active

//- ============================================================
//- AVATARS
//- ============================================================
section.pt-12.space-y-3
	h2 Avatar
	p.text-sm.text-fg-muted Falls back from
		code src
		| → initials → a lucide
		code user
		| glyph.
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Sizes
			.flex.flex-wrap.items-center.gap-4
				Avatar(name="Ada Lovelace" size="sm")
				Avatar(name="Ada Lovelace" size="md")
				Avatar(name="Ada Lovelace" size="lg")
				Avatar(name="Grace Hopper" size="xl")
		Card
			+snippet('header')
				h3.text-base.font-semibold Source / fallback
			.flex.flex-wrap.items-center.gap-4
				Avatar(src="https://i.pravatar.cc/150?img=12" name="Photo" size="lg")
				Avatar(name="Linus Torvalds" size="lg")
				Avatar(size="lg")
				.relative.inline-block
					Avatar(name="Ada Lovelace" size="lg")
					span.absolute.bottom-0.right-0.size-3.rounded-full.ring-2(style="background: var(--color-success-500); --tw-ring-color: var(--color-bg)")

//- ============================================================
//- SKELETON + PROGRESS
//- ============================================================
section.pt-12.space-y-3
	h2 Skeleton / Progress
	p.text-sm.text-fg-muted Loading placeholders + linear / circular determinate / indeterminate bars.
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Skeleton
			.space-y-2
				Skeleton(variant="text" width="60%")
				Skeleton(variant="text" width="80%")
				Skeleton(variant="text" width="40%")
				.flex.items-center.gap-3.pt-2
					Skeleton(variant="circle" width="40" height="40")
					.flex-1.space-y-2
						Skeleton(variant="text" width="50%")
						Skeleton(variant="text" width="70%")
				Skeleton(width="100%" height="80")
		Card
			+snippet('header')
				h3.text-base.font-semibold Progress
			.space-y-3
				Progress(value!="{30}")
				Progress(value!="{60}" variant="success")
				Progress(value!="{85}" variant="warning")
				Progress(value!="{40}" variant="danger")
				Progress(indeterminate!="{true}")
				.flex.items-center.gap-4.pt-1
					ProgressCircular(value!="{45}" size="sm")
					ProgressCircular(value!="{70}" size="md")
					ProgressCircular(indeterminate!="{true}" size="lg")

//- ============================================================
//- TREE VIEW
//- ============================================================
section.pt-12.space-y-3
	h2 Tree
	p.text-sm.text-fg-muted Recursive nodes; click to expand or select. Bind
		code expanded
		| (array of ids) and
		code selected
		| .
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Files
			Tree(items!="{treeItems}" bind:expanded!="{treeExpanded}" bind:selected!="{treeSelected}")
		Card
			+snippet('header')
				h3.text-base.font-semibold Selected
			pre.text-xs.m-0(style="background: transparent; padding: 0")
				| selected: {treeSelected ?? '∅'}
			pre.text-xs.m-0.mt-2(style="background: transparent; padding: 0")
				| expanded: {JSON.stringify(treeExpanded)}

//- ============================================================
//- BREADCRUMBS + PAGINATION
//- ============================================================
section.pt-12.space-y-3
	h2 Breadcrumbs / Pagination
	p.text-sm.text-fg-muted Wayfinding pair — trail of the current location plus paged navigation.
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Breadcrumbs
			.space-y-2
				Breadcrumbs(items!="{[{ label: 'Home', href: '/' }, { label: 'Examples', href: '/examples' }, { label: 'norns-ui' }]}")
				Breadcrumbs(separator="›" items!="{[{ label: 'Org', href: '#' }, { label: 'Repo', href: '#' }, { label: 'main', href: '#' }, { label: 'src' }]}")
		Card
			+snippet('header')
				h3.text-base.font-semibold Pagination
			Pagination(bind:page!="{pageNum}" total!="{183}" pageSize!="{10}")
			p.mt-3.text-xs.text-fg-muted Page {pageNum} of 19

//- ============================================================
//- STEPPER + ACCORDION
//- ============================================================
section.pt-12.space-y-3
	h2 Stepper / Accordion
	p.text-sm.text-fg-muted Step-by-step progress paired with collapsible details. Accordion uses native
		code &lt;details&gt;
		| ; pass
		code multiple
		| to allow several open at once.
	+snippet('a1')
		p Lighter than chrome plate, heavier than a Faraday cage.
	+snippet('a2')
		p Polyphonic notes layered through ratio-based wave folding.
	+snippet('a3')
		p Knobs are smooth-detented; macros bind via shift-click.
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Stepper
			.space-y-6
				Stepper(steps!="{stepperSteps}" current!="{stepIdx}")
				.flex.gap-2
					Btn(variant="ghost" size="sm" icon="lucide:chevron-left" onclick!="{() => stepIdx = Math.max(0, stepIdx - 1)}") Prev
					Btn(variant="primary" size="sm" onclick!="{() => stepIdx = Math.min(stepperSteps.length - 1, stepIdx + 1)}")
						| Next
						+snippet('trailing')
							Icon(name="lucide:chevron-right" size="size-4")
		Card
			+snippet('header')
				h3.text-base.font-semibold Accordion
			Accordion(items!="{[{ value: 'a', title: 'Build quality', content: a1 }, { value: 'b', title: 'Sound design', content: a2 }, { value: 'c', title: 'Controls', content: a3 }]}")

//- ============================================================
//- CAROUSEL
//- ============================================================
section.pt-12.space-y-3
	h2 Carousel
	p.text-sm.text-fg-muted Default
		code aspect="video"
		| ; pass
		code aspect="square"
		| or
		code aspect="wide"
		| , or override with
		code class="aspect-[…]"
		| .
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold 16:9 video (default)
			Carousel(slides!="{carouselSlides}")
		Card
			+snippet('header')
				h3.text-base.font-semibold Square + autoplay
			Carousel(slides!="{carouselSlides}" aspect="square" autoplay!="{true}" interval!="{3500}")

//- ============================================================
//- HEADER (composite)
//- ============================================================
section.pt-12.space-y-3
	h2 Header
	p.text-sm.text-fg-muted Site header — brand / nav / actions slots.
	Header
		+snippet('brand')
			.size-7.rounded.flex.items-center.justify-center.text-white.font-bold.text-sm(style="background: var(--color-primary-600)") N
			span Norns
		+snippet('nav')
			Btn(variant="ghost" size="sm") Home
			Btn(variant="ghost" size="sm") Docs
			Btn(variant="ghost" size="sm") Examples
		+snippet('actions')
			Btn(variant="ghost" size="sm" icon="lucide:search")
			Btn(variant="primary" size="sm") Sign in

//- ============================================================
//- HERO
//- ============================================================
section.pt-12.space-y-3
	h2 HeroBanner
	p.text-sm.text-fg-muted Page-opening banner with title / description / actions slots.
		code align="center"
		| flips to centered.
	.grid.gap-4.lg:grid-cols-2
		HeroBanner(title="Build apps you can read in five minutes." description="Pug + Civet on top of Svelte 5. Feature folders, DI, valibot." align="left")
			+snippet('actions')
				Btn(variant="primary" icon="lucide:rocket") Get started
				Btn(variant="ghost" icon="lucide:book-open") Read the docs
		HeroBanner(title="Centered hero" description="Same API; align='center'." align="center")
			+snippet('actions')
				Btn(variant="primary") Try it
				Btn(variant="link") Skip

//- ============================================================
//- DIALOG / SHEET
//- ============================================================
section.pt-12.space-y-3
	h2 Dialog / Sheet
	p.text-sm.text-fg-muted Portal + focus trap + scroll lock + escape, on the shared behaviors module. Sheet covers all four sides; the
		code side="left"
		| variant replaces the old
		code Drawer
		| .
	.flex.flex-wrap.gap-2
		Dialog(bind:open!="{dialogOpen}" title="Delete this item?" description="This cannot be undone." triggerClass="btn btn-danger")
			+snippet('trigger')
				Icon(name="lucide:trash-2" size="size-4")
				| Open dialog
			+snippet('actions')
				Btn(variant="ghost" onclick!="{cancelDialog}") Cancel
				Btn(variant="danger" onclick!="{confirmDialog}") Confirm
		Sheet(bind:open!="{sheetLeft}" side="left" title="Left sheet" triggerClass="btn btn-secondary")
			+snippet('trigger')
				Icon(name="lucide:panel-left" size="size-4")
				| Sheet left
			p.text-sm.text-fg-muted Slides in from the left edge.
		Sheet(bind:open!="{sheetRight}" side="right" title="Right sheet" triggerClass="btn btn-secondary")
			+snippet('trigger')
				Icon(name="lucide:panel-right" size="size-4")
				| Sheet right
			p.text-sm.text-fg-muted Slides in from the right edge.
		Sheet(bind:open!="{sheetBottom}" side="bottom" title="Bottom sheet" triggerClass="btn btn-secondary")
			+snippet('trigger')
				Icon(name="lucide:panel-bottom" size="size-4")
				| Sheet bottom

//- ============================================================
//- POPOVER / DROPDOWN / TOOLTIP
//- ============================================================
section.pt-12.space-y-3
	h2 Popover / Dropdown / Tooltip
	p.text-sm.text-fg-muted Floating overlays — positioned with
		code @floating-ui/dom
		| , portaled to
		code &lt;body&gt;
		| , close on click-outside / Escape.
	.flex.flex-wrap.items-center.gap-3
		Popover(triggerClass="btn btn-ghost")
			+snippet('trigger')
				| Popover
			.space-y-2
				p.text-sm Custom content goes here.
				Field(label="Status")
					Select(name="status")
						option(value="all") All
						option(value="open") Open
		Dropdown(items!="{dropdownItems}" triggerClass="btn btn-ghost")
			+snippet('trigger')
				| Actions ▾
		Tooltip(content="Saved 2 minutes ago" triggerClass="btn btn-ghost")
			+snippet('trigger')
				Icon(name="lucide:info" size="size-4")
		Tooltip(content="Quick action" side="right" triggerClass="btn btn-ghost")
			+snippet('trigger')
				Icon(name="lucide:zap" size="size-4")
		Tooltip(content="Esc to dismiss" side="bottom" triggerClass="btn btn-ghost")
			+snippet('trigger')
				Icon(name="lucide:keyboard" size="size-4")

//- ============================================================
//- TABS
//- ============================================================
section.pt-12.space-y-3
	h2 Tabs
	+snippet('panelOverview')
		p.text-sm.text-fg-muted Overview content. Keyboard nav (←/→, Home, End) and aria roles wired.
	+snippet('panelDetails')
		p.text-sm.text-fg-muted Details content.
	+snippet('panelSettings')
		p.text-sm.text-fg-muted Settings content. The disabled tab is skipped on keyboard nav.
	Tabs(bind:value!="{tab}" items!="{[{ value: 'overview', label: 'Overview', panel: panelOverview }, { value: 'details', label: 'Details', panel: panelDetails }, { value: 'settings', label: 'Settings', panel: panelSettings, disabled: true }]}")

//- ============================================================
//- TOAST
//- ============================================================
section.pt-12.space-y-3
	h2 Toast
	p.text-sm.text-fg-muted Imperative API:
		code toast(msg, opts)
		| . Bottom-right region;
		code duration: 0
		| stays until dismissed.
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Variants
			.flex.flex-wrap.items-center.gap-2
				Btn(variant="primary"   onclick!="{toastInfo}")    info
				Btn(variant="secondary" onclick!="{toastSuccess}") success
				Btn(variant="secondary" onclick!="{toastWarning}") warning
				Btn(variant="danger"    onclick!="{toastError}")   error
		Card
			+snippet('header')
				h3.text-base.font-semibold Duration
			.flex.flex-wrap.items-center.gap-2
				Btn(variant="ghost" onclick!="{toastSticky}") sticky (duration: 0)
				Btn(variant="ghost" onclick!="{() => toast('Quick toast', { duration: 1500 })}") 1.5s
				Btn(variant="ghost" onclick!="{() => toast('Long toast', { duration: 8000 })}") 8s

//- ============================================================
//- DATA TABLE
//- ============================================================
section.pt-12.space-y-3
	h2 DataTable
	p.text-sm.text-fg-muted Styled minimal table — sticky header, optional striping, sortable columns.
	DataTable(
		columns!="{tableColumns}"
		rows!="{tableRows}"
		striped!="{true}"
		bind:sortKey!="{tableSortKey}"
		bind:sortDir!="{tableSortDir}"
	)

//- ============================================================
//- DATE / TIME
//- ============================================================
section.pt-12.space-y-3
	h2 DatePicker / DateRangePicker / TimePicker
	p.text-sm.text-fg-muted All three are Popover + a custom Calendar / time grid — no external date library.
	.grid.gap-4.md:grid-cols-3
		Card
			+snippet('header')
				h3.text-base.font-semibold DatePicker
			DatePicker(bind:value!="{datePickerValue}")
		Card
			+snippet('header')
				h3.text-base.font-semibold DateRangePicker
			DateRangePicker(bind:value!="{dateRangeValue}")
		Card
			+snippet('header')
				h3.text-base.font-semibold TimePicker
			TimePicker(bind:value!="{timeValue}")

//- ============================================================
//- AUTOCOMPLETE / MULTISELECT / TAGS
//- ============================================================
section.pt-12.space-y-3
	h2 Autocomplete / MultiSelect / TagsInput
	p.text-sm.text-fg-muted Custom combobox + listbox — arrow keys / Home / End navigate, Enter selects, Esc closes.
	.grid.gap-4.md:grid-cols-3
		Card
			+snippet('header')
				h3.text-base.font-semibold Autocomplete
			Field(label="Framework")
				Autocomplete(items!="{frameworkOptions}" bind:value!="{acValue}" placeholder="Type to search…")
		Card
			+snippet('header')
				h3.text-base.font-semibold MultiSelect
			Field(label="Frameworks")
				MultiSelect(items!="{frameworkOptions}" bind:value!="{msValue}" placeholder="Pick many…")
		Card
			+snippet('header')
				h3.text-base.font-semibold TagsInput
			Field(label="Tags" help="Press , or Enter to add")
				TagsInput(bind:value!="{tagsValue}" placeholder="Add a tag…")

//- ============================================================
//- NUMBER / OTP / COLOR
//- ============================================================
section.pt-12.space-y-3
	h2 NumberInput / OtpField / ColorPicker
	p.text-sm.text-fg-muted Specialised inputs — clamped integers, segmented one-time-passwords, and a hex+swatch combo.
	.grid.gap-4.md:grid-cols-3
		Card
			+snippet('header')
				h3.text-base.font-semibold NumberInput
			Field(label="Quantity" help="min 0, max 99")
				NumberInput(bind:value!="{numValue}" min!="{0}" max!="{99}")
		Card
			+snippet('header')
				h3.text-base.font-semibold OtpField
			Field(label="6-digit code")
				OtpField(bind:value!="{otpValue}" length!="{6}")
			p.text-xs.mt-2.text-fg-muted value: {otpValue || '∅'}
		Card
			+snippet('header')
				h3.text-base.font-semibold ColorPicker
			Field(label="Brand color")
				ColorPicker(bind:value!="{colorValue}")

//- ============================================================
//- UPLOADER
//- ============================================================
section.pt-12.space-y-3
	h2 Uploader
	p.text-sm.text-fg-muted Drag and drop or click. Multi-file by default.
	Uploader(bind:files!="{uploadFiles}" helper="Up to 10MB each")

//- ============================================================
//- TOGGLES (BUTTON / GROUP / BUTTONGROUP / SEPARATOR / TOOLBAR)
//- ============================================================
section.pt-12.space-y-3
	h2 Toggles / ButtonGroup / Toolbar / Separator
	p.text-sm.text-fg-muted ToggleButton is
		code .btn-secondary[data-pressed]
		| — same visual language as buttons, just with a pressed state.
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold ToggleButton + ToggleButtonGroup
			.space-y-3
				.flex.flex-wrap.items-center.gap-3
					ToggleButton(bind:pressed!="{boldOn}" icon="lucide:bold" aria-label="Bold")
					ToggleButton(bind:pressed!="{italicOn}" icon="lucide:italic" aria-label="Italic")
					ToggleButton(bind:pressed!="{underlineOn}" icon="lucide:underline" aria-label="Underline")
				ToggleButtonGroup(items!="{alignmentOptions}" bind:value!="{alignment}")
		Card
			+snippet('header')
				h3.text-base.font-semibold ButtonGroup + Toolbar
			.space-y-3
				ButtonGroup
					Btn(variant="secondary" size="sm" icon="lucide:rotate-ccw") Undo
					Btn(variant="secondary" size="sm" icon="lucide:rotate-cw") Redo
					Btn(variant="secondary" size="sm" icon="lucide:save") Save
				Toolbar(label="Editor toolbar")
					Btn(variant="ghost" size="sm" icon="lucide:bold")
					Btn(variant="ghost" size="sm" icon="lucide:italic")
					Btn(variant="ghost" size="sm" icon="lucide:underline")
					Separator.mx-1(orientation="vertical")
					Btn(variant="ghost" size="sm" icon="lucide:list")
					Btn(variant="ghost" size="sm" icon="lucide:list-ordered")
					Separator.mx-1(orientation="vertical")
					Btn(variant="ghost" size="sm" icon="lucide:link")

//- ============================================================
//- COLLAPSIBLE / TOOLTIP (rich)
//- ============================================================
section.pt-12.space-y-3
	h2 Collapsible / Tooltip (rich)
	p.text-sm.text-fg-muted Collapsible is one section of expand-collapse (use Accordion for many).
		code rich
		| swaps Tooltip's compact dark style for a surface-elevated card; ideal for previewing user cards or links.
	.grid.gap-4.md:grid-cols-3
		Card
			+snippet('header')
				h3.text-base.font-semibold Collapsible
			.space-y-2
				Collapsible(title="Show details")
					p.text-sm.text-fg-muted Inline expand-collapse for one section. Use Accordion for many.
				Collapsible(title="More info")
					p.text-sm.text-fg-muted Each instance is independent.
		Card
			+snippet('header')
				h3.text-base.font-semibold Tooltip (rich)
			.flex.gap-2
				Tooltip(rich!="{true}" triggerClass="btn btn-ghost")
					+snippet('trigger')
						Icon(name="lucide:info" size="size-4")
						| Hover
					.flex.gap-3
						Avatar(name="Ada Lovelace" size="md")
						.text-sm
							.font-semibold Ada Lovelace
							p.text-xs.text-fg-muted First programmer.
		Card
			+snippet('header')
				h3.text-base.font-semibold Tooltip on a link
			.text-sm
				| Hover the
				| ' '
				Tooltip(rich!="{true}" delay!="{500}" triggerClass="underline text-primary-600")
					+snippet('trigger')
						a(href="https://svelte.dev" target="_blank" rel="noreferrer") Svelte link
					.text-sm
						.font-semibold svelte.dev
						p.text-xs.mt-1.text-fg-muted Cybernetically enhanced web apps.

//- ============================================================
//- CONTEXT MENU / HIERARCHICAL / MEGA MENU
//- ============================================================
section.pt-12.space-y-3
	h2 ContextMenu / HierarchicalMenu / MegaMenu
	p.text-sm.text-fg-muted Right-click + horizontal nav patterns. Hierarchical opens on hover/focus; ContextMenu anchors to the pointer.
	Card
		+snippet('header')
			h3.text-base.font-semibold ContextMenu (right-click)
		ContextMenu(items!="{ctxItems}")
			+snippet('trigger')
				.surface.p-6.text-center.text-sm.text-fg-muted Right-click anywhere in this box

	Card.mt-4
		+snippet('header')
			h3.text-base.font-semibold HierarchicalMenu
		HierarchicalMenu(items!="{hierItems}")

	Card.mt-4
		+snippet('header')
			h3.text-base.font-semibold MegaMenu
		MegaMenu(sections!="{megaSections}")

//- ============================================================
//- SCROLL AREA
//- ============================================================
section.pt-12.space-y-3
	h2 ScrollArea
	p.text-sm.text-fg-muted Constrained-height region with native scrollbars. Pass
		code horizontal
		| for x-axis scroll instead.
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Vertical (default)
			ScrollArea.h-48
				.p-2.space-y-1
					+each('scrollList as i')
						.px-3.py-1.5.rounded.text-sm.bg-bg-muted Item {i}
		Card
			+snippet('header')
				h3.text-base.font-semibold Horizontal
			ScrollArea.h-32(horizontal!="{true}")
				.flex.gap-2.p-2
					+each('scrollList as i')
						.shrink-0.px-4.py-3.rounded.text-sm.font-medium.bg-bg-muted Card {i}

//- ============================================================
//- TIMELINE
//- ============================================================
section.pt-12.space-y-3
	h2 Timeline
	p.text-sm.text-fg-muted Vertical event list with colored dots — pass
		code variant
		| per item to tint.
	Card
		Timeline(items!="{timelineItems}")

//- ============================================================
//- MEDIA (IMAGE / AUDIO / VIDEO)
//- ============================================================
section.pt-12.pb-24.space-y-3
	h2 Image / Audio / Video
	p.text-sm.text-fg-muted Thin wrappers around the native elements — aspect ratio, loading state, sensible defaults.
	.grid.gap-4.md:grid-cols-3
		Card(padded!="{false}")
			Image.aspect-video(src="https://picsum.photos/id/1043/600/400" alt="Sample")
			.p-3.text-xs.text-fg-muted Image with aspect-video
		Card
			+snippet('header')
				h3.text-base.font-semibold Audio
			Audio(src="https://www.w3.org/2010/05/sound/sound.mp3")
			p.text-xs.mt-2.text-fg-muted Native
				code &lt;audio&gt;
				| with controls
		Card(padded!="{false}")
			Video(
				src="https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/360/Big_Buck_Bunny_360_10s_1MB.mp4"
				muted!="{true}"
				class="aspect-video"
			)
			.p-3.text-xs.text-fg-muted Native
				code &lt;video&gt;
				| , muted

//- ============================================================
//- AVATAR GROUP
//- ============================================================
section.pt-12.space-y-3
	h2 AvatarGroup
	p.text-sm.text-fg-muted Overlapping avatars with hover lift; truncates to
		code +N
		| once max is reached.
	Card
		.flex.flex-wrap.items-center.gap-8
			AvatarGroup(items!="{teamSmall}" size="sm")
			AvatarGroup(items!="{teamMd}" size="md")
			AvatarGroup(items!="{teamLg}" size="lg" max!="{4}")

//- ============================================================
//- ANIMATED TEXT + ANIMATED NUMBER
//- ============================================================
section.pt-12.space-y-3
	h2 GradientText / AnimatedNumber
	p.text-sm.text-fg-muted GradientText is CSS-only and free.
		code AnimatedNumber
		| lives in the
		code /motion
		| subpath since it pulls in Motion One.
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold GradientText
			.text-3xl.font-bold.tracking-tight
				GradientText Build for the web — beautifully.
			p.text-sm.mt-3.text-fg-muted Animated background-position; CSS-only.
		Card
			+snippet('header')
				h3.text-base.font-semibold AnimatedNumber
			.flex.items-end.gap-3
				.text-5xl.font-bold.leading-none
					AnimatedNumber(value!="{counter}" duration!="{1.2}")
				span.text-sm.pb-1.text-fg-muted downloads
			.flex.gap-2.mt-4
				Btn(variant="secondary" size="sm" onclick!="{() => counter += 312}") +312
				Btn(variant="secondary" size="sm" onclick!="{() => counter = 12345}") set 12 345
				Btn(variant="ghost" size="sm" onclick!="{() => counter = 0}") reset

//- ============================================================
//- COPY / SHINY / RIPPLE / LIQUID BUTTONS
//- ============================================================
section.pt-12.space-y-3
	h2 CopyButton / ShinyButton / RippleButton / LiquidButton
	p.text-sm.text-fg-muted Decorative button variants. The first three are CSS-only; LiquidButton lives in the
		code /motion
		| subpath.
	Card
		.flex.flex-wrap.items-center.gap-3
			CopyButton(value="@human-synthesis/norns-ui" variant="secondary") Copy package
			ShinyButton(variant="primary" icon="lucide:sparkles") Shiny
			RippleButton(variant="primary" icon="lucide:waves") Click for ripple
			LiquidButton(variant="primary" icon="lucide:droplet") Hover for liquid

//- ============================================================
//- REVEAL + SPARKLES + GRADIENT BACKGROUND
//- ============================================================
section.pt-12.space-y-3
	h2 Reveal / Sparkles / GradientBackground
	p.text-sm.text-fg-muted All three live in the
		code /motion
		| subpath. Free to remix; pause on
		code prefers-reduced-motion
		| .
	.grid.gap-4.md:grid-cols-2
		Card
			+snippet('header')
				h3.text-base.font-semibold Reveal
			.h-32.overflow-hidden
				p.text-sm.text-fg-muted Scroll the page — wrappers fade up when entering the viewport.
			Reveal(direction="up" delay!="{0.1}")
				.text-base.mt-2 Hello — I revealed myself.
			Reveal(direction="up" delay!="{0.25}")
				.text-base I followed.
			Reveal(direction="up" delay!="{0.4}")
				.text-base.font-semibold And me last.
		Card
			+snippet('header')
				h3.text-base.font-semibold Sparkles
			.flex.justify-center.py-4
				Sparkles
					Btn(variant="primary" icon="lucide:zap") I have sparkles
	GradientBackground.rounded-lg.overflow-hidden.p-8.mt-4.text-white
		h3.text-2xl.font-semibold GradientBackground
		p.text-sm.mt-2.opacity-90 Looping color-stop animation. CSS-driven; pauses off-screen via IntersectionObserver.

<script>
	import { toast } from '@human-synthesis/norns-ui/toast'
	import { addCollection } from '@iconify/svelte'
	import lucideIcons from '@iconify-json/lucide/icons.json'

	// Motion-driven components live in the opt-in subpath — pulled in only here.
	import AnimatedNumber from '@human-synthesis/norns-ui/motion/AnimatedNumber.n'
	import Reveal from '@human-synthesis/norns-ui/motion/Reveal.n'
	import LiquidButton from '@human-synthesis/norns-ui/motion/LiquidButton.n'
	import Sparkles from '@human-synthesis/norns-ui/motion/Sparkles.n'
	import GradientBackground from '@human-synthesis/norns-ui/motion/GradientBackground.n'

	addCollection lucideIcons

	counter .= $state 12345
	teamSmall := [
		{ name: 'Ada Lovelace' }
		{ name: 'Grace Hopper' }
		{ name: 'Donald Knuth' }
	]
	teamMd := [
		{ name: 'Ada Lovelace' }
		{ name: 'Grace Hopper' }
		{ name: 'Donald Knuth' }
		{ name: 'Linus Torvalds' }
	]
	teamLg := [
		{ name: 'Ada Lovelace' }
		{ name: 'Grace Hopper' }
		{ name: 'Donald Knuth' }
		{ name: 'Linus Torvalds' }
		{ name: 'Anders Hejlsberg' }
		{ name: 'Tim Berners-Lee' }
		{ name: 'Margaret Hamilton' }
	]

	radio        .= $state 'm'
	toggle       .= $state true
	dialogOpen   .= $state false
	sheetLeft    .= $state false
	sheetRight   .= $state false
	sheetBottom  .= $state false
	tab          .= $state 'overview'
	pageNum      .= $state 4
	stepIdx      .= $state 1
	treeExpanded .= $state ['src', 'src/lib']
	treeSelected .= $state 'src/lib/cn.js'

	// 0.0.4 state
	tableSortKey .= $state 'name'
	tableSortDir .= $state 'asc'
	datePickerValue .= $state ''
	dateRangeValue  .= $state { start: '', end: '' }
	timeValue       .= $state ''
	acValue         .= $state ''
	msValue         .= $state ['svelte', 'pug']
	tagsValue       .= $state ['norns', 'pug', 'civet']
	numValue        .= $state 5
	otpValue        .= $state ''
	colorValue      .= $state '#7c3aed'
	uploadFiles     .= $state []
	boldOn          .= $state true
	italicOn        .= $state false
	underlineOn     .= $state false
	alignment       .= $state 'left'

	cancelDialog  := => dialogOpen = false
	confirmDialog := =>
		dialogOpen = false
		toast 'Deleted', { variant: 'success' }

	toastInfo    := -> toast 'Heads up.', { variant: 'info' }
	toastSuccess := -> toast 'Saved!', { variant: 'success' }
	toastWarning := -> toast 'Hmm, take a look.', { variant: 'warning' }
	toastError   := -> toast 'Something failed.', { variant: 'error' }
	toastSticky  := -> toast 'Sticky — close manually.', { duration: 0 }

	dropdownItems := [
		{ label: 'Edit',      onSelect: -> toast 'Edit clicked' }
		{ label: 'Duplicate', onSelect: -> toast 'Duplicated' }
		{ separator: true }
		{ label: 'Delete',    onSelect: -> toast 'Deleted', { variant: 'error' } }
	]

	stepperSteps := [
		{ label: 'Account' }
		{ label: 'Profile' }
		{ label: 'Preferences' }
		{ label: 'Review' }
	]

	carouselSlides := [
		{ src: 'https://picsum.photos/id/1018/1600/600', alt: 'Mountain' }
		{ src: 'https://picsum.photos/id/1015/1600/600', alt: 'River' }
		{ src: 'https://picsum.photos/id/1019/1600/600', alt: 'Forest' }
	]

	palette := [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950]
	frameworkOptions := [
		{ value: 'svelte',  label: 'Svelte' }
		{ value: 'react',   label: 'React' }
		{ value: 'vue',     label: 'Vue' }
		{ value: 'solid',   label: 'Solid' }
		{ value: 'angular', label: 'Angular' }
		{ value: 'pug',     label: 'Pug' }
		{ value: 'civet',   label: 'Civet' }
	]

	alignmentOptions := [
		{ value: 'left',   icon: 'lucide:align-left',   label: 'Align left',   iconOnly: true }
		{ value: 'center', icon: 'lucide:align-center', label: 'Align center', iconOnly: true }
		{ value: 'right',  icon: 'lucide:align-right',  label: 'Align right',  iconOnly: true }
		{ value: 'justify', icon: 'lucide:align-justify', label: 'Justify', iconOnly: true }
	]

	tableColumns := [
		{ key: 'name',     label: 'Name',     sortable: true }
		{ key: 'role',     label: 'Role',     sortable: true }
		{ key: 'language', label: 'Language', sortable: true }
		{ key: 'status',   label: 'Status' }
	]
	tableRows := [
		{ name: 'Ada Lovelace',     role: 'Programmer',   language: 'Analytical',   status: 'Pioneer' }
