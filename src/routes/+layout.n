.min-h-screen.flex.flex-col
	AppHeader
	//- Three width modes:
	//-   - landing: edge-to-edge (sections constrain themselves internally)
	//-   - showcase: 1600px cap for the catalog's 2- and 3-col grids
	//-   - default:  reading-width 3xl for the framework pages
	//- All classes live in Pug shorthand so the pugTailwindExtract plugin
	//- picks them up. The one arbitrary width (1600px) goes via inline style
	//- — Tailwind can't infer that from a JS-string expression.
	+if('isLanding')
		main.flex-1.w-full
			| {@render children?.()}
	+if('isShowcase')
		main.flex-1.w-full.mx-auto.px-6.py-16.sm:px-8.lg:px-12(style="max-width: 1600px")
			| {@render children?.()}
	+if('isWide')
		main.flex-1.w-full.mx-auto.px-6.py-16.max-w-5xl.sm:px-8.lg:px-10
			| {@render children?.()}
	+if('!isLanding && !isShowcase && !isWide')
		main.flex-1.w-full.mx-auto.px-6.py-16.max-w-3xl.sm:px-8.lg:px-10
			| {@render children?.()}
	+if('!isLanding')
		.flex.justify-center.pb-10.pt-4
			.inline-flex.items-center.gap-2.text-xs.text-neutral-400.font-mono
				span.w-2.h-2.rounded-full(class="bg-violet-400 animate-pulse")
				| norns-ui v{__NORNS_UI_VERSION__} · early access

<script>
	import { page } from '$app/state'

	{ children } := $props()

	isLanding := $derived page.url.pathname.startsWith '/examples/landing'
	isShowcase := $derived page.url.pathname.startsWith '/examples/ui'
	// TRON examples carry tables and side-by-side payloads: reading width is too narrow.
	isWide := $derived page.url.pathname.startsWith '/examples/tron'
</script>
